# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=expensedb
POSTGRES_USER=expenseuser
POSTGRES_PASSWORD=expensepass

# ─── Backend ─────────────────────────────────────────────────────────────────
JWT_SECRET=supersecretjwtkey_changeme_in_production_min32chars
JWT_EXPIRES_IN=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── MinIO (object storage for receipts) ─────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=receipts

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── Redis (not in use yet — see docker-compose.yml) ─────────────────────────
# REDIS_URL=redis://redis:6379

# ─── Caddy (production only — see docker-compose.yml) ────────────────────────
# CADDY_DOMAIN=yourdomain.com
